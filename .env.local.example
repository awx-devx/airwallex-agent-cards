# ─────────────────────────────────────────────────────────────
# Airwallex DEMO / sandbox credentials
# Get these from the Airwallex demo dashboard:
#   https://demo.airwallex.com  →  Developer  →  API keys
# ─────────────────────────────────────────────────────────────
AIRWALLEX_CLIENT_ID=your-demo-client-id
AIRWALLEX_API_KEY=your-demo-api-key

# Base URL for all API calls (demo/sandbox). Do not change for the demo.
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com

# Airwallex.js environment ('demo' | 'staging' | 'prod'). Keep 'demo' here.
NEXT_PUBLIC_AIRWALLEX_ENV=demo

# Cardholder used when issuing cards. Optional:
#   - If set, cards are issued to this cardholder id.
#   - If empty, the app uses the first cardholder returned by the API,
#     and if none exist it auto-creates a demo company cardholder.
AIRWALLEX_CARDHOLDER_ID=

# ─────────────────────────────────────────────────────────────
# Claude API — powers the natural-language chat interface
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─────────────────────────────────────────────────────────────
# App auth (simple developer login). Any username works;
# this is the shared password for the demo login screen.
# ─────────────────────────────────────────────────────────────
DEMO_PASSWORD=treasury
# Secret used to sign the session cookie. Change to any random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of this app (used to build HPP success/failure URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
